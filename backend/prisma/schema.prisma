generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                 @db.VarChar(255)
  email             String                 @unique @db.VarChar(255)
  password          String                 @db.VarChar(255)
  role              UserRole
  isActive          Boolean                @default(true) @map("is_active")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  auditLogs         AuditLog[]
  statusHistory     BookingStatusHistory[]
  createdParties    Party[]                @relation("CreatedBy")
  party             Party?                 @relation("PartyUser")
  refreshTokens     RefreshToken[]
  tripInfoDownloads TripInfo[]             @relation("TripInfoDownloadedBy")
  tripInfoUpdates   TripInfo[]             @relation("TripInfoUpdatedBy")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Party {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyName             String         @map("party_name") @db.VarChar(255)
  email                 String         @unique @db.VarChar(255)
  contactNumber         String?        @map("contact_number") @db.VarChar(20)
  whatsappNumber        String?        @map("whatsapp_number") @db.VarChar(20)
  address               String?
  gstNumber             String?        @map("gst_number") @db.VarChar(50)
  customerType          CustomerType   @map("customer_type")
  isSupplier            Boolean        @default(false) @map("is_supplier")
  isCustomer            Boolean        @default(true) @map("is_customer")
  loginRequired         Boolean        @default(false) @map("login_required")
  userId                String?        @unique @map("user_id") @db.Uuid
  createdBy             String         @map("created_by") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  emailNotification     Boolean        @default(true) @map("email_notification")
  marketingNotification Boolean        @default(false) @map("marketing_notification")
  smsNotification       Boolean        @default(true) @map("sms_notification")
  accountCurrencyId     String         @map("account_currency_id") @db.Uuid
  accountCurrency       CurrencyMaster @relation(fields: [accountCurrencyId], references: [id])
  creator               User           @relation("CreatedBy", fields: [createdBy], references: [id])
  user                  User?          @relation("PartyUser", fields: [userId], references: [id])
  limits                PartyLimits?
  services              Service[]

  @@index([email])
  @@index([partyName])
  @@index([customerType])
  @@index([userId])
  @@index([accountCurrencyId])
  @@map("parties")
}

model Service {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceType      String            @map("service_type") @db.VarChar(50)
  partyId          String            @map("party_id") @db.Uuid
  status           ServiceStatus     @default(pending)
  submittedAt      DateTime          @default(now()) @map("submitted_at") @db.Timestamp(6)
  details          Json?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  documents        Document[]
  party            Party             @relation(fields: [partyId], references: [id], onDelete: Cascade)
  umrahVisaBooking UmrahVisaBooking?

  @@index([partyId])
  @@index([serviceType])
  @@index([status])
  @@map("services")
}

model UmrahVisaBooking {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId            String                     @unique @map("service_id") @db.Uuid
  groupNumber          String?                    @map("group_number") @db.VarChar(100)
  groupName            String?                    @map("group_name") @db.VarChar(255)
  passengerCount       Int                        @map("passenger_count")
  status               UmrahVisaStatus            @default(pending)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt            DateTime?                  @map("deleted_at") @db.Timestamp(6)
  isDeleted            Boolean                    @default(false) @map("is_deleted")
  hasGroupNumber       Boolean                    @default(false) @map("has_group_number")
  accommodationType    AccommodationType?         @map("accommodation_type")
  visaType             VisaType                   @default(individual_visa) @map("visa_type")
  hasTransportation    Boolean                    @default(false) @map("has_transportation")
  voucherGeneratedAt   DateTime?                  @map("voucher_generated_at") @db.Timestamp(6)
  voucherGeneratedBy   String?                    @map("voucher_generated_by") @db.Uuid
  billGeneratedAt      DateTime?                  @map("bill_generated_at") @db.Timestamp(6)
  billGeneratedBy      String?                    @map("bill_generated_by") @db.Uuid
  statusHistory        BookingStatusHistory[]
  tripInfo             TripInfo?
  accommodationDetails UmrahAccommodationDetails?
  passengers           UmrahPassenger[]
  transportBookings    UmrahTransportBooking[]
  travelDetails        UmrahTravelDetails?
  service              Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([status])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([hasGroupNumber])
  @@index([accommodationType])
  @@index([visaType])
  @@index([hasTransportation])
  @@map("umrah_visa_bookings")
}

model UmrahPassenger {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String              @map("booking_id") @db.Uuid
  isLeadPassenger Boolean             @default(false) @map("is_lead_passenger")
  fullName        String              @map("full_name") @db.VarChar(255)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamp(6)
  isDeleted       Boolean             @default(false) @map("is_deleted")
  documents       PassengerDocument[]
  booking         UmrahVisaBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([isLeadPassenger])
  @@index([isDeleted])
  @@map("umrah_passengers")
}

model TransportPricing {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId       String    @map("route_id") @db.VarChar(100)
  price         Decimal   @db.Decimal(10, 2)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  paxCount      Int       @map("pax_count")
  transportType String    @map("transport_type") @db.VarChar(50)
  validFrom     DateTime  @map("valid_from") @db.Timestamp(6)
  validTo       DateTime? @map("valid_to") @db.Timestamp(6)

  @@index([routeId, transportType, paxCount])
  @@index([isActive])
  @@index([validFrom, validTo])
  @@map("transport_pricing")
}

model Document {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId    String    @map("service_id") @db.Uuid
  documentType String    @map("document_type") @db.VarChar(100)
  fileName     String    @map("file_name") @db.VarChar(255)
  filePath     String    @map("file_path") @db.VarChar(500)
  fileSize     Int?
  mimeType     String?   @map("mime_type") @db.VarChar(100)
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamp(6)
  passengerId  String?   @map("passenger_id") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp(6)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  service      Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([passengerId])
  @@index([documentType])
  @@index([isDeleted])
  @@map("documents")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model BookingStatusHistory {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String           @map("booking_id") @db.Uuid
  oldStatus String?          @map("old_status") @db.VarChar(50)
  newStatus String           @map("new_status") @db.VarChar(50)
  changedBy String           @map("changed_by") @db.Uuid
  reason    String?          @db.VarChar(500)
  changedAt DateTime         @default(now()) @map("changed_at") @db.Timestamp(6)
  isDeleted Boolean          @default(false) @map("is_deleted")
  deletedAt DateTime?        @map("deleted_at") @db.Timestamp(6)
  booking   UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [changedBy], references: [id])

  @@index([bookingId])
  @@index([changedBy])
  @@index([changedAt])
  @@map("booking_status_history")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(50)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  changedBy  String   @map("changed_by") @db.Uuid
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamp(6)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  user       User     @relation(fields: [changedBy], references: [id])

  @@index([entityType, entityId])
  @@index([changedBy])
  @@index([changedAt])
  @@map("audit_logs")
}

model PartyLimits {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyId            String   @unique @map("party_id") @db.Uuid
  maxPassengers      Int      @default(50) @map("max_passengers")
  maxPassengersIqama Int      @default(5) @map("max_passengers_iqama")
  maxTravelDays      Int      @default(80) @map("max_travel_days")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  party              Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_limits")
}

model CancellationPolicy {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(100)
  daysBeforeTravel Int      @map("days_before_travel")
  cancellationFee  Decimal  @map("cancellation_fee") @db.Decimal(10, 2)
  refundPercentage Decimal  @map("refund_percentage") @db.Decimal(5, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([isActive])
  @@index([daysBeforeTravel])
  @@map("cancellation_policies")
}

model TransportMaster {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleType    String            @map("vehicle_type") @db.VarChar(50)
  paxCount       Int               @map("pax_count")
  price          Decimal           @db.Decimal(10, 2)
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  fromLocationId String            @map("from_location_id") @db.Uuid
  toLocationId   String            @map("to_location_id") @db.Uuid
  fromLocation   DestinationMaster @relation("TransportMasterFrom", fields: [fromLocationId], references: [id])
  toLocation     DestinationMaster @relation("TransportMasterTo", fields: [toLocationId], references: [id])

  @@unique([fromLocationId, toLocationId, vehicleType, paxCount])
  @@unique([fromLocationId, toLocationId, vehicleType, paxCount], map: "transport_masters_from_location_id_to_location_id_vehicle__key")
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([vehicleType])
  @@index([paxCount])
  @@index([isActive])
  @@map("transport_masters")
}

model CurrencyMaster {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currencyCode String   @unique @map("currency_code") @db.VarChar(3)
  currencyName String   @map("currency_name") @db.VarChar(50)
  symbol       String   @db.VarChar(10)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  parties      Party[]

  @@index([currencyCode])
  @@index([currencyName])
  @@index([isActive])
  @@map("currency_masters")
}

model CountryMaster {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode  String   @unique @map("country_code") @db.VarChar(3)
  countryName  String   @map("country_name") @db.VarChar(100)
  currencyCode String   @map("currency_code") @db.VarChar(3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([countryCode])
  @@index([countryName])
  @@index([isActive])
  @@map("country_masters")
}

model DestinationMaster {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinationCode     String                  @unique @map("destination_code") @db.VarChar(10)
  destinationName     String                  @map("destination_name") @db.VarChar(100)
  city                String                  @db.VarChar(100)
  country             String                  @default("Saudi Arabia") @db.VarChar(100)
  isActive            Boolean                 @default(true) @map("is_active")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  hotels              HotelMaster[]
  transportMasterFrom TransportMaster[]       @relation("TransportMasterFrom")
  transportMasterTo   TransportMaster[]       @relation("TransportMasterTo")
  hotelBookings       UmrahHotelBooking[]
  transportFromMaster UmrahTransportBooking[] @relation("TransportFrom")
  transportToMaster   UmrahTransportBooking[] @relation("TransportTo")

  @@index([destinationCode])
  @@index([destinationName])
  @@index([city])
  @@index([isActive])
  @@map("destination_masters")
}

model HotelMaster {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelCode     String              @unique @map("hotel_code") @db.VarChar(20)
  hotelName     String              @map("hotel_name") @db.VarChar(255)
  locationId    String              @map("location_id") @db.Uuid
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  location      DestinationMaster   @relation(fields: [locationId], references: [id])
  hotelBookings UmrahHotelBooking[]

  @@index([hotelCode])
  @@index([hotelName])
  @@index([locationId])
  @@index([isActive])
  @@map("hotel_masters")
}


model AirportMaster {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  airportCode      String               @unique @map("airport_code") @db.VarChar(10)
  airportName      String               @map("airport_name") @db.VarChar(255)
  city             String               @db.VarChar(100)
  country          String               @default("Saudi Arabia") @db.VarChar(100)
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  arrivalFlights   UmrahTravelDetails[] @relation("ArrivalAirport")
  departureFlights UmrahTravelDetails[] @relation("DepartureAirport")

  @@index([airportCode])
  @@index([airportName])
  @@index([city])
  @@index([isActive])
  @@map("airport_masters")
}

model UmrahTravelDetails {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String           @unique @map("booking_id") @db.Uuid
  arrivalDate           DateTime         @map("arrival_date") @db.Date
  arrivalTime           DateTime         @map("arrival_time") @db.Time
  arrivalAirportId      String           @map("arrival_airport_id") @db.Uuid
  arrivalFlightNumber   String           @map("arrival_flight_number") @db.VarChar(50)
  departureDate         DateTime         @map("departure_date") @db.Date
  departureTime         DateTime         @map("departure_time") @db.Time
  departureAirportId    String           @map("departure_airport_id") @db.Uuid
  departureFlightNumber String           @map("departure_flight_number") @db.VarChar(50)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  arrivalAirport        AirportMaster    @relation("ArrivalAirport", fields: [arrivalAirportId], references: [id])
  booking               UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  departureAirport      AirportMaster    @relation("DepartureAirport", fields: [departureAirportId], references: [id])

  @@index([bookingId])
  @@index([arrivalDate])
  @@index([departureDate])
  @@index([arrivalAirportId])
  @@index([departureAirportId])
  @@map("umrah_travel_details")
}

model UmrahAccommodationDetails {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId                 String              @unique @map("booking_id") @db.Uuid
  accommodationType         AccommodationType   @map("accommodation_type")
  iqamaNumber               String?             @map("iqama_number") @db.VarChar(50)
  iqamaName                 String?             @map("iqama_name") @db.VarChar(255)
  iqamaDob                  DateTime?           @map("iqama_dob") @db.Date
  iqamaMobile               String?             @map("iqama_mobile") @db.VarChar(20)
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  iqamaNationalShortAddress String?             @map("iqama_national_short_address") @db.VarChar(500)
  booking                   UmrahVisaBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelBookings             UmrahHotelBooking[]

  @@index([bookingId])
  @@index([accommodationType])
  @@map("umrah_accommodation_details")
}

model UmrahHotelBooking {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accommodationId String                    @map("accommodation_id") @db.Uuid
  locationId      String                    @map("location_id") @db.Uuid
  hotelId         String                    @map("hotel_id") @db.Uuid
  checkInDate     DateTime                  @map("checkin_date") @db.Date
  checkOutDate    DateTime                  @map("checkout_date") @db.Date
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  accommodation   UmrahAccommodationDetails @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  hotel           HotelMaster               @relation(fields: [hotelId], references: [id])
  location        DestinationMaster         @relation(fields: [locationId], references: [id])

  @@index([accommodationId])
  @@index([locationId])
  @@index([hotelId])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@map("umrah_hotel_bookings")
}

model UmrahTransportBooking {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String            @map("booking_id") @db.Uuid
  fromLocationId String            @map("from_location_id") @db.Uuid
  toLocationId   String            @map("to_location_id") @db.Uuid
  vehicleType    String            @map("vehicle_type") @db.VarChar(50)
  paxCount       Int               @map("pax_count")
  price          Decimal           @map("price") @db.Decimal(10, 2)
  travelDate     DateTime?         @map("travel_date") @db.Date
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  booking        UmrahVisaBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromLocation   DestinationMaster @relation("TransportFrom", fields: [fromLocationId], references: [id])
  toLocation     DestinationMaster @relation("TransportTo", fields: [toLocationId], references: [id])

  @@index([bookingId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([vehicleType])
  @@index([travelDate])
  @@map("umrah_transport_bookings")
}

model PassengerDocument {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passengerId  String         @map("passenger_id") @db.Uuid
  documentType String         @map("document_type") @db.VarChar(100)
  fileName     String         @map("file_name") @db.VarChar(255)
  filePath     String         @map("file_path") @db.VarChar(500)
  fileSize     Int?
  mimeType     String?        @map("mime_type") @db.VarChar(100)
  uploadedAt   DateTime       @default(now()) @map("uploaded_at") @db.Timestamp(6)
  isDeleted    Boolean        @default(false) @map("is_deleted")
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamp(6)
  passenger    UmrahPassenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@index([passengerId])
  @@index([documentType])
  @@index([isDeleted])
  @@map("passenger_documents")
}

model TripInfo {
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId                 String           @unique @map("booking_id") @db.Uuid
  groupNumber               String?          @map("group_number") @db.VarChar(100)
  groupName                 String?          @map("group_name") @db.VarChar(255)
  partyName                 String           @map("party_name") @db.VarChar(255)
  arrivalDate               DateTime         @map("arrival_date") @db.Date
  departureDate             DateTime         @map("departure_date") @db.Date
  iqamaNumber               String?          @map("iqama_number") @db.VarChar(50)
  iqamaHolderName           String?          @map("iqama_holder_name") @db.VarChar(255)
  iqamaHolderDob            DateTime?        @map("iqama_holder_dob") @db.Date
  iqamaHolderMobile         String?          @map("iqama_holder_mobile") @db.VarChar(20)
  iqamaNationalShortAddress String?          @map("iqama_national_short_address") @db.VarChar(500)
  documentsDownloadCount    Int              @default(0) @map("documents_download_count")
  documentsDownloadedAt     DateTime?        @map("documents_downloaded_at") @db.Timestamp(6)
  documentsDownloadedBy     String?          @map("documents_downloaded_by") @db.Uuid
  confirmationImagePath     String?          @map("confirmation_image_path") @db.VarChar(500)
  confirmationUploadedAt    DateTime?        @map("confirmation_uploaded_at") @db.Timestamp(6)
  updatedBy                 String           @map("updated_by") @db.Uuid
  status                    UmrahVisaStatus
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  booking                   UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  documentsDownloadedByUser User?            @relation("TripInfoDownloadedBy", fields: [documentsDownloadedBy], references: [id])
  updatedByUser             User             @relation("TripInfoUpdatedBy", fields: [updatedBy], references: [id])

  @@index([bookingId])
  @@index([groupNumber])
  @@index([status])
  @@index([updatedBy])
  @@map("trip_info")
}

