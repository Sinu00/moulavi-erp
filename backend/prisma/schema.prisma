generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                 @db.VarChar(255)
  email             String                 @unique @db.VarChar(255)
  password          String                 @db.VarChar(255)
  role              UserRole
  isActive          Boolean                @default(true) @map("is_active")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  auditLogs         AuditLog[]
  statusHistory     BookingStatusHistory[]
  createdParties    Party[]                @relation("CreatedBy")
  party             Party?                 @relation("PartyUser")
  refreshTokens     RefreshToken[]
  tripInfoDownloads TripInfo[]             @relation("TripInfoDownloadedBy")
  tripInfoUpdates   TripInfo[]             @relation("TripInfoUpdatedBy")
  vouchersGenerated Voucher[]              @relation("VoucherGeneratedBy")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Party {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyName             String         @map("party_name") @db.VarChar(255)
  email                 String         @unique @db.VarChar(255)
  contactNumber         String?        @map("contact_number") @db.VarChar(20)
  whatsappNumber        String?        @map("whatsapp_number") @db.VarChar(20)
  address               String?
  gstNumber             String?        @map("gst_number") @db.VarChar(50)
  customerType          CustomerType   @map("customer_type")
  isSupplier            Boolean        @default(false) @map("is_supplier")
  isCustomer            Boolean        @default(true) @map("is_customer")
  loginRequired         Boolean        @default(false) @map("login_required")
  userId                String?        @unique @map("user_id") @db.Uuid
  createdBy             String         @map("created_by") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  emailNotification     Boolean        @default(true) @map("email_notification")
  marketingNotification Boolean        @default(false) @map("marketing_notification")
  smsNotification       Boolean        @default(true) @map("sms_notification")
  accountCurrencyId     String         @map("account_currency_id") @db.Uuid
  panNumber             String?        @map("pan_number") @db.VarChar(50)
  aadhaarNumber         String?        @map("aadhaar_number") @db.VarChar(50)
  supplierServiceTypes  Json?          @map("supplier_service_types")
  accountCurrency       CurrencyMaster @relation(fields: [accountCurrencyId], references: [id])
  creator               User           @relation("CreatedBy", fields: [createdBy], references: [id])
  user                  User?          @relation("PartyUser", fields: [userId], references: [id])
  contacts              PartyContact[]
  documents             PartyDocument[]
  umrahVisaBookings     UmrahVisaBooking[] @relation("UmrahVisaProvider")
  bookings              UmrahVisaBooking[] @relation("BookingParty")

  @@index([email])
  @@index([partyName])
  @@index([customerType])
  @@index([userId])
  @@index([accountCurrencyId])
  @@map("parties")
}

model UmrahVisaBooking {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyId              String                     @map("party_id") @db.Uuid
  submittedAt          DateTime                   @default(now()) @map("submitted_at") @db.Timestamp(6)
  groupNumber          String?                    @map("group_number") @db.VarChar(100)
  groupName            String?                    @map("group_name") @db.VarChar(255)
  passengerCount       Int                        @map("passenger_count")
  umrahVisaProviderId String?                     @map("umrah_visa_provider_id") @db.Uuid
  status               UmrahVisaStatus            @default(pending)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt            DateTime?                  @map("deleted_at") @db.Timestamp(6)
  isDeleted            Boolean                    @default(false) @map("is_deleted")
  hasGroupNumber       Boolean                    @default(false) @map("has_group_number")
  accommodationType    AccommodationType?         @map("accommodation_type")
  visaType             VisaType                   @default(individual_visa) @map("visa_type")
  hasTransportation    Boolean                    @default(false) @map("has_transportation")
  voucherGeneratedAt   DateTime?                  @map("voucher_generated_at") @db.Timestamp(6)
  voucherGeneratedBy   String?                    @map("voucher_generated_by") @db.Uuid
  billGeneratedAt      DateTime?                  @map("bill_generated_at") @db.Timestamp(6)
  billGeneratedBy      String?                    @map("bill_generated_by") @db.Uuid
  statusHistory        BookingStatusHistory[]
  tripInfo             TripInfo?
  hotelBookings        UmrahHotelBooking[]
  sponsorIqamaDetails  UmrahSponserIqamaDetails?
  passengers           UmrahPassenger[]
  transportBookings    UmrahTransportBooking[]
  travelDetails        UmrahTravelDetails?
  voucher              Voucher?
  documents            Document[]
  party                Party                      @relation("BookingParty", fields: [partyId], references: [id], onDelete: Cascade)
  umrahVisaProvider    Party?                     @relation("UmrahVisaProvider", fields: [umrahVisaProviderId], references: [id])

  @@index([partyId])
  @@index([status])
  @@index([umrahVisaProviderId])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([hasGroupNumber])
  @@index([accommodationType])
  @@index([visaType])
  @@index([hasTransportation])
  @@index([submittedAt])
  @@map("umrah_visa_bookings")
}

model UmrahPassenger {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String              @map("booking_id") @db.Uuid
  isLeadPassenger Boolean             @default(false) @map("is_lead_passenger")
  fullName        String              @map("full_name") @db.VarChar(255)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamp(6)
  isDeleted       Boolean             @default(false) @map("is_deleted")
  documents       PassengerDocument[]
  booking         UmrahVisaBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([isLeadPassenger])
  @@index([isDeleted])
  @@map("umrah_passengers")
}

model Document {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String            @map("booking_id") @db.Uuid
  documentType String            @map("document_type") @db.VarChar(100)
  fileName     String            @map("file_name") @db.VarChar(255)
  filePath     String            @map("file_path") @db.VarChar(500)
  fileSize     Int?
  mimeType     String?           @map("mime_type") @db.VarChar(100)
  uploadedAt   DateTime          @default(now()) @map("uploaded_at") @db.Timestamp(6)
  passengerId  String?           @map("passenger_id") @db.Uuid
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamp(6)
  isDeleted    Boolean           @default(false) @map("is_deleted")
  booking      UmrahVisaBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([passengerId])
  @@index([documentType])
  @@index([isDeleted])
  @@map("documents")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model BookingStatusHistory {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String           @map("booking_id") @db.Uuid
  oldStatus String?          @map("old_status") @db.VarChar(50)
  newStatus String           @map("new_status") @db.VarChar(50)
  changedBy String           @map("changed_by") @db.Uuid
  reason    String?          @db.VarChar(500)
  changedAt DateTime         @default(now()) @map("changed_at") @db.Timestamp(6)
  isDeleted Boolean          @default(false) @map("is_deleted")
  deletedAt DateTime?        @map("deleted_at") @db.Timestamp(6)
  booking   UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [changedBy], references: [id])

  @@index([bookingId])
  @@index([changedBy])
  @@index([changedAt])
  @@map("booking_status_history")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(50)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  changedBy  String   @map("changed_by") @db.Uuid
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamp(6)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent")
  user       User     @relation(fields: [changedBy], references: [id])

  @@index([entityType, entityId])
  @@index([changedBy])
  @@index([changedAt])
  @@map("audit_logs")
}

model CancellationPolicy {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(100)
  daysBeforeTravel Int      @map("days_before_travel")
  cancellationFee  Decimal  @map("cancellation_fee") @db.Decimal(10, 2)
  refundPercentage Decimal  @map("refund_percentage") @db.Decimal(5, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([isActive])
  @@index([daysBeforeTravel])
  @@map("cancellation_policies")
}

model VehicleTypeMaster {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleName  String            @unique @map("vehicle_name") @db.VarChar(100)
  paxCount     Int               @map("pax_count")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  transports   TransportMaster[]

  @@index([vehicleName])
  @@index([paxCount])
  @@index([isActive])
  @@map("vehicle_type_masters")
}

model CurrencyMaster {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currencyCode String   @unique @map("currency_code") @db.VarChar(3)
  currencyName String   @map("currency_name") @db.VarChar(50)
  symbol       String   @db.VarChar(10)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  parties      Party[]

  @@index([currencyCode])
  @@index([currencyName])
  @@index([isActive])
  @@map("currency_masters")
}

model CountryMaster {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode  String           @unique @map("country_code") @db.VarChar(3)
  countryName  String           @map("country_name") @db.VarChar(100)
  currencyCode String           @map("currency_code") @db.VarChar(3)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  locations    LocationMaster[]
  cities       CityMaster[]

  @@index([countryCode])
  @@index([countryName])
  @@index([isActive])
  @@map("country_masters")
}

model CityMaster {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String          @map("name") @db.VarChar(255)
  countryId String          @map("country_id") @db.Uuid
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  country   CountryMaster   @relation(fields: [countryId], references: [id])
  locations LocationMaster[]
  transportRoutesAsCity1 TransportRouteMaster[] @relation("TransportRouteCity1")
  transportRoutesAsCity2 TransportRouteMaster[] @relation("TransportRouteCity2")
  transportRoutesAsCity3 TransportRouteMaster[] @relation("TransportRouteCity3")
  transportRoutesAsCity4 TransportRouteMaster[] @relation("TransportRouteCity4")

  @@unique([name, countryId])
  @@index([name])
  @@index([countryId])
  @@index([isActive])
  @@map("city_masters")
}

model LocationMaster {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String       @map("code") @db.VarChar(20)
  name         String       @map("name") @db.VarChar(255)
  locationType LocationType @map("location_type")
  countryId    String       @map("country_id") @db.Uuid
  cityId       String       @map("city_id") @db.Uuid
  city         String       @db.VarChar(100)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  country             CountryMaster           @relation(fields: [countryId], references: [id])
  cityMaster          CityMaster              @relation(fields: [cityId], references: [id])
  hotelBookings       UmrahHotelBooking[]     @relation("HotelBookings")
  hotelBookingLocations UmrahHotelBooking[]   @relation("HotelBookingLocations")
  transportFromMaster UmrahTransportBooking[] @relation("TransportFrom")
  transportToMaster   UmrahTransportBooking[] @relation("TransportTo")
  transportFromSpecific UmrahTransportBooking[] @relation("TransportFromSpecific")
  transportToSpecific   UmrahTransportBooking[] @relation("TransportToSpecific")
  arrivalFlights      UmrahTravelDetails[]    @relation("ArrivalAirport")
  departureFlights    UmrahTravelDetails[]    @relation("DepartureAirport")

  @@unique([code, locationType])
  @@index([code])
  @@index([name])
  @@index([locationType])
  @@index([countryId])
  @@index([cityId])
  @@index([isActive])
  @@map("location_masters")
}


model UserRoleMaster {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleCode     String   @unique @map("role_code") @db.VarChar(50)
  roleName     String   @map("role_name") @db.VarChar(100)
  permissions  Json     @db.JsonB
  description  String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([roleCode])
  @@index([roleName])
  @@index([isActive])
  @@map("user_role_masters")
}

model TransportRouteMaster {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city1Id      String      @map("city1_id") @db.Uuid
  city2Id      String      @map("city2_id") @db.Uuid
  city3Id      String?     @map("city3_id") @db.Uuid
  city4Id      String?     @map("city4_id") @db.Uuid
  routeType    RouteType   @map("route_type")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  city1        CityMaster  @relation("TransportRouteCity1", fields: [city1Id], references: [id])
  city2        CityMaster  @relation("TransportRouteCity2", fields: [city2Id], references: [id])
  city3        CityMaster? @relation("TransportRouteCity3", fields: [city3Id], references: [id])
  city4        CityMaster? @relation("TransportRouteCity4", fields: [city4Id], references: [id])
  transports   TransportMaster[]

  @@index([city1Id])
  @@index([city2Id])
  @@index([routeType])
  @@index([isActive])
  @@map("transport_route_masters")
}

model TransportMaster {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId        String                @map("route_id") @db.Uuid
  vehicleTypeId  String                @map("vehicle_type_id") @db.Uuid
  price          Decimal               @db.Decimal(10, 2)
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  route          TransportRouteMaster  @relation(fields: [routeId], references: [id])
  vehicleType   VehicleTypeMaster     @relation(fields: [vehicleTypeId], references: [id])

  @@unique([routeId, vehicleTypeId])
  @@index([routeId])
  @@index([vehicleTypeId])
  @@index([isActive])
  @@map("transport_masters")
}

model UmrahTravelDetails {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String           @unique @map("booking_id") @db.Uuid
  arrivalDateTime       DateTime         @map("arrival_datetime") @db.Timestamp(6)
  arrivalAirportId      String           @map("arrival_airport_id") @db.Uuid
  arrivalFlightNumber   String           @map("arrival_flight_number") @db.VarChar(50)
  departureDateTime     DateTime         @map("departure_datetime") @db.Timestamp(6)
  departureAirportId    String           @map("departure_airport_id") @db.Uuid
  departureFlightNumber String           @map("departure_flight_number") @db.VarChar(50)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  arrivalAirport        LocationMaster   @relation("ArrivalAirport", fields: [arrivalAirportId], references: [id])
  booking               UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  departureAirport      LocationMaster   @relation("DepartureAirport", fields: [departureAirportId], references: [id])

  @@index([bookingId])
  @@index([arrivalDateTime])
  @@index([departureDateTime])
  @@index([arrivalAirportId])
  @@index([departureAirportId])
  @@map("umrah_travel_details")
}

model UmrahHotelBooking {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String           @map("booking_id") @db.Uuid
  locationId      String           @map("location_id") @db.Uuid
  hotelId         String           @map("hotel_id") @db.Uuid
  checkInDate     DateTime         @map("checkin_date") @db.Date
  checkOutDate    DateTime         @map("checkout_date") @db.Date
  brn             Json?            @map("brn")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  booking         UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel           LocationMaster   @relation("HotelBookings", fields: [hotelId], references: [id])
  location        LocationMaster   @relation("HotelBookingLocations", fields: [locationId], references: [id])

  @@index([bookingId])
  @@index([locationId])
  @@index([hotelId])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@map("umrah_hotel_bookings")
}

model UmrahSponserIqamaDetails {
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId                 String           @unique @map("booking_id") @db.Uuid
  iqamaSponserName          String           @map("iqama_sponser_name") @db.VarChar(255)
  iqamaNumber               String           @map("iqama_number") @db.VarChar(50)
  sponserDob                DateTime         @map("sponser_dob") @db.Date
  sponserMobileNumber       String           @map("sponser_mobile_number") @db.VarChar(20)
  sponserNationalShortAddress String         @map("sponser_national_short_address") @db.VarChar(500)
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  booking                   UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([iqamaNumber])
  @@map("umrah_sponser_iqama_details")
}

model UmrahTransportBooking {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String           @map("booking_id") @db.Uuid
  fromLocationId        String           @map("from_location_id") @db.Uuid
  toLocationId          String           @map("to_location_id") @db.Uuid
  fromSpecificLocationId String?         @map("from_specific_location_id") @db.Uuid
  toSpecificLocationId   String?         @map("to_specific_location_id") @db.Uuid
  vehicleType           String           @map("vehicle_type") @db.VarChar(50)
  paxCount              Int              @map("pax_count")
  price                 Decimal          @map("price") @db.Decimal(10, 2)
  travelDateTime        DateTime?        @map("travel_datetime") @db.Timestamp(6)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  booking               UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromLocation          LocationMaster   @relation("TransportFrom", fields: [fromLocationId], references: [id])
  toLocation            LocationMaster   @relation("TransportTo", fields: [toLocationId], references: [id])
  fromSpecificLocation  LocationMaster?  @relation("TransportFromSpecific", fields: [fromSpecificLocationId], references: [id])
  toSpecificLocation    LocationMaster?  @relation("TransportToSpecific", fields: [toSpecificLocationId], references: [id])

  @@index([bookingId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([fromSpecificLocationId])
  @@index([toSpecificLocationId])
  @@index([vehicleType])
  @@index([travelDateTime])
  @@map("umrah_transport_bookings")
}

model PassengerDocument {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passengerId  String         @map("passenger_id") @db.Uuid
  documentType String         @map("document_type") @db.VarChar(100)
  fileName     String         @map("file_name") @db.VarChar(255)
  filePath     String         @map("file_path") @db.VarChar(500)
  fileSize     Int?
  mimeType     String?        @map("mime_type") @db.VarChar(100)
  uploadedAt   DateTime       @default(now()) @map("uploaded_at") @db.Timestamp(6)
  isDeleted    Boolean        @default(false) @map("is_deleted")
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamp(6)
  passenger    UmrahPassenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@index([passengerId])
  @@index([documentType])
  @@index([isDeleted])
  @@map("passenger_documents")
}

model TripInfo {
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId                 String           @unique @map("booking_id") @db.Uuid
  groupNumber               String?          @map("group_number") @db.VarChar(100)
  groupName                 String?          @map("group_name") @db.VarChar(255)
  partyName                 String           @map("party_name") @db.VarChar(255)
  arrivalDate               DateTime         @map("arrival_date") @db.Date
  departureDate             DateTime         @map("departure_date") @db.Date
  iqamaNumber               String?          @map("iqama_number") @db.VarChar(50)
  iqamaHolderName           String?          @map("iqama_holder_name") @db.VarChar(255)
  iqamaHolderDob            DateTime?        @map("iqama_holder_dob") @db.Date
  iqamaHolderMobile         String?          @map("iqama_holder_mobile") @db.VarChar(20)
  iqamaNationalShortAddress String?          @map("iqama_national_short_address") @db.VarChar(500)
  documentsDownloadCount    Int              @default(0) @map("documents_download_count")
  documentsDownloadedAt     DateTime?        @map("documents_downloaded_at") @db.Timestamp(6)
  documentsDownloadedBy     String?          @map("documents_downloaded_by") @db.Uuid
  confirmationImagePath     String?          @map("confirmation_image_path") @db.VarChar(500)
  confirmationUploadedAt    DateTime?        @map("confirmation_uploaded_at") @db.Timestamp(6)
  updatedBy                 String           @map("updated_by") @db.Uuid
  status                    UmrahVisaStatus
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  booking                   UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  documentsDownloadedByUser User?            @relation("TripInfoDownloadedBy", fields: [documentsDownloadedBy], references: [id])
  updatedByUser             User             @relation("TripInfoUpdatedBy", fields: [updatedBy], references: [id])

  @@index([bookingId])
  @@index([groupNumber])
  @@index([status])
  @@index([updatedBy])
  @@map("trip_info")
}

model Voucher {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String           @unique @map("booking_id") @db.Uuid
  voucherNumber     String           @map("voucher_number") @db.VarChar(20)
  reservationDate   DateTime         @map("reservation_date") @db.Date
  guestName         String           @map("guest_name") @db.VarChar(255)
  guestMobile       String?          @map("guest_mobile") @db.VarChar(20)
  groupCode         String?          @map("group_code") @db.VarChar(100)
  umrahVisaProviderId String?        @map("umrah_visa_provider_id") @db.Uuid
  paxCount          Int              @map("pax_count")
  hotelSchedules    Json             @map("hotel_schedules")
  movementDetails   Json             @map("movement_details")
  flightDetails     Json             @map("flight_details")
  version           Int              @default(1)
  generatedAt       DateTime         @default(now()) @map("generated_at") @db.Timestamp(6)
  generatedBy       String           @map("generated_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  booking           UmrahVisaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  generatedByUser   User             @relation("VoucherGeneratedBy", fields: [generatedBy], references: [id])

  @@unique([voucherNumber])
  @@index([bookingId])
  @@index([voucherNumber])
  @@index([generatedAt])
  @@index([generatedBy])
  @@map("vouchers")
}

